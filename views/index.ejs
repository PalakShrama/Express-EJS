<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>StyleMe - Outfit Suggester</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="web">
    <header>
      <div class="navbar">
        <div class="nav-logo border">
          <div class="logo"></div>
        </div>
        <div class="nav-address border">
          <p class="add-first">Deliver to</p>
          <div class="add-icon">
            <i class="fa-solid fa-location-dot"></i>
            <p class="add-sec">India</p>
          </div>
        </div>

        <div class="nav-search border">
          <select class="search-select border">
            <option>ALL</option>
          </select>
          <input class="search-input" placeholder="Search Outfits">
          <div class="search-icon border">
            <i class="fa-solid fa-magnifying-glass"></i>
          </div>
        </div>

        <div class="lan">
          <select class="select border">
            <option>lang</option>
          </select>
        </div>
        <div class="signin border">
          <p id="h2"><span>Hello, sign in</span></p>
          <p id="h1">Account & lists</p>
        </div>
        <div class="orders border">
          <p id="h2"><span>Returns</span></p>
          <p id="h1">& Orders</p>
        </div>
        <div class="cart-icon border">
          <i class="fa-solid fa-cart-shopping"></i>
          Cart
        </div>
      </div>

      <div class="line">
        <div class="d1">
          <div class="all border">
            <i class="fa-solid fa-bars"></i>
            All
          </div>
          <div class="ops">
            <p class="i1 border"><a id="k1" href="#">Today's Deals</a></p>
            <p class="i2 border"><a id="k1" href="#">Customer Services</a></p>
            <p class="i3 border"><a id="k1" href="#">Registry</a></p>
            <p class="i4 border"><a id="k1" href="#">Gift Cards</a></p>
            <p class="i5 border"><a id="k1" href="#">Sell</a></p>
          </div>
          <div class="ele border"><a id="k1" href="#">Shop latest fashion trends</a></div>
        </div>
      </div>
    </header>

    <contain>
      <div class="hero">
        <!-- ✅ Updated background image -->
        <div class="image" style="background-image:url('https://mir-s3-cdn-cf.behance.net/project_modules/1400/ea4957197090651.662a56246dcec.png'); 
                                   background-size:cover; 
                                   background-position:center; 
                                   background-repeat:no-repeat; 
                                   height:500px; 
                                   width:100%;">
          <shop>
            <div class="shop">
              <div class="start border"><a href="/login">Explore Outfits</a></div>
              <div class="shop-logo border">
                <div class="s-logo"></div>
              </div>
            </div>
          </shop>
          <div class="msg">
            <p>You are on StyleMe.com <a href="#">Click here to explore outfit inspirations</a></p>
          </div>
        </div>
      </div>
    </contain>

    <contain>
  <div class="hri">
    <div class="j5 border">
      <div class="jj5 border">
        <h2>Boho</h2>
        <div class="j_img" style="background-image:url('toho.jpg');"></div>
      </div>
      <div class="jj5 border">
        <h2>Indo-Western</h2>
        <div class="j_img" style="background-image:url('indo.jpg');"></div>
      </div>
      <div class="jj5 border">
        <h2>Streetwear</h2>
        <div class="j_img" style="background-image:url('street.jpg');"></div>
      </div>
      <div class="jj5 border">
        <h2>Formal</h2>
        <div class="j_img" style="background-image:url('for.jpg');"></div>
      </div>
    </div>

    <div class="j6">
      <div class="jj5 border">
        <h2>Fusion</h2>
        <div class="j_img" style="background-image:url('fus.jpg');"></div>
      </div>
      <div class="jj5 border">
        <h2>Minimalist</h2>
        <div class="j_img" style="background-image:url('list.jpg');"></div>
      </div>
      <div class="jj5 border">
        <h2>Ethnic</h2>
        <div class="j_img" style="background-image:url('ethenic.jpg');"></div>
      </div>
      <div class="jj5 border">
        <h2>Party</h2>
        <div class="j_img" style="background-image:url('party.jpg');"></div>
      </div>
    </div>

    <div class="j7">
      <div class="jj5 border">
        <h2>Casual</h2>
        <div class="j_img" style="background-image:url('styl.jpg');"></div>
      </div>
      <div class="jj5 border">
        <h2>Workwear</h2>
        <div class="j_img" style="background-image:url('work.jpg');"></div>
      </div>
      <div class="jj5 border">
        <h2>Traditional</h2>
        <div class="j_img" style="background-image:url('traditional.jpg');"></div>
      </div>
      <div class="jj5 border">
        <h2>Festive</h2>
        <div class="j_img" style="background-image:url('festive.jpg');"></div>
      </div>
    </div>
  </div>
</contain>
    <footer>
      <div class="foot">
        <div class="th1">
          <div class="thank border">Thank you</div>
        </div>
        <div class="list">
          <ul>
            <p>Get to Know Us</p>
            <a>Careers</a>
            <a>Blog</a>
            <a>About StyleMe</a>
            <a>Investors</a>
            <a>Devices</a>
            <a>Sciences</a>
          </ul>
          <ul>
            <p>Customer Care</p>
            <a>Help</a>
            <a>Feedback</a>
            <a>Query</a>
            <a>Text with bot</a>
            <a>Complain</a>
            <a>Join</a>
          </ul>
        </div>
      </div>
      <div class="last_line">Copyrights.#17687397</div>
    </footer>
  </div>
</body>
</html>














